{
  "expo": {
    "name": "PDF Invoice Manager",
    "slug": "pdf-invoice-manager",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0078D4"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.pdfinvoice.manager"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0078D4"
      },
      "package": "com.pdfinvoice.manager"
    },
    "plugins": [
      "expo-secure-store",
      "expo-document-picker",
      "expo-font",
      "expo-asset"
    ]
  }
}
